{
  "name": "banking-app",
  "version": "2.0.0",
  "description": "Backend banking simulator with atomic money operations, balanced journals, session security, and reconciliation",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "seed": "node scripts/seed.js",
    "lint": "eslint src/ tests/ scripts/ server.js",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.js\" \"scripts/**/*.js\" server.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --coverage",
    "test:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand tests/integration",
    "migrate": "node scripts/migrate.js",
    "doctor": "node scripts/doctor.js",
    "test:redis": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand tests/redis",
    "create-admin": "node scripts/create-admin.js",
    "audit:production": "npm audit --omit=dev"
  },
  "keywords": [
    "banking",
    "fintech",
    "ledger",
    "idempotency",
    "mongodb-transactions",
    "redis"
  ],
  "author": "Ayush",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.12.1",
    "redis": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "eslint": "^10.14.0",
    "jest": "^30.5.2",
    "mongodb-memory-server": "^11.3.0",
    "prettier": "^3.5.2",
    "supertest": "^7.3.1"
  },
  "jest": {
    "testTimeout": 30000,
    "roots": [
      "<rootDir>/tests"
    ],
    "setupFiles": [
      "<rootDir>/tests/setup-env.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 50,
        "functions": 75,
        "lines": 75,
        "statements": 75
      }
    }
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
