NODE_ENV=development
PORT=3000
# Standalone development requires a replica set, not a plain mongod.
MONGO_URI=mongodb://localhost:27017/banking-app?replicaSet=rs0
REDIS_URL=redis://localhost:6379
# Generate two separate secrets before running: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_random_access_secret_at_least_32_chars
JWT_REFRESH_SECRET=replace_with_a_different_random_refresh_secret_at_least_32_chars
CLIENT_URL=http://localhost:3000
BANK_TIMEZONE=Asia/Kolkata
DAILY_TRANSFER_LIMIT_PAISE=10000000
# Self-service funding is opt-in: set to true only on a development machine.
SANDBOX_DEPOSITS_ENABLED=true
# Number of proxies in front of the API. Keep 0 for direct local access; set to 1
# on Render/Fly/Railway or anything terminating TLS in front of Node.
TRUST_PROXY_HOPS=0
LOG_REQUESTS=false
